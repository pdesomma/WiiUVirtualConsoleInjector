<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             xmlns:vc="using:PD.WiiU.VirtualConsole"
             xmlns:conv="using:WiiUVirtualConsoleInjector.Converters"
             x:Class="WiiUVirtualConsoleInjector.Views.BasesView"
             x:DataType="vm:BasesViewModel">

    <UserControl.Styles>

        <!-- Tab pill labels follow the pill's selection colour -->
        <Style Selector="ListBox.tabs ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.tabs ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Row-level text -->
        <Style Selector="TextBlock.base-name">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.base-region">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.base-id">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.title-key">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One of the three keys: label above, text, and whether it is stored -->
        <DataTemplate x:DataType="vm:KeyEntryViewModel">
            <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{Binding Label}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Classes="mono" Text="{Binding Text}" PlaceholderText="32 hex characters" />
                    <TextBlock Grid.Column="1" Classes="hint" Text="{Binding SavedStatus}" VerticalAlignment="Center" MinWidth="58" ToolTip.Tip="Whether this box has been stored; the app cannot tell whether the key itself is right." />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="20">

            <!-- Keys -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Keys" />
                    <StackPanel Spacing="16">
                        <ContentControl Content="{Binding WiiUCommonKeyEntry}" />
                        <ContentControl Content="{Binding WiiCommonKeyEntry}" />
                        <Border Classes="divider" Padding="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="sm" Content="Read from otp.bin…" Command="{Binding ImportOtpCommand}" />
                                <TextBlock Classes="hint" Text="Reads the Wii U common key out of an otp.bin dump." VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bases -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Bases" Margin="0,0,0,12" />

                    <!-- Console tab pills -->
                    <ListBox Classes="tabs" ItemsSource="{Binding Consoles}" SelectedItem="{Binding SelectedConsole}" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vc:SourceConsole">
                                <TextBlock Text="{Binding, Converter={x:Static conv:ConsoleConverters.Name}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Filter -->
                    <TextBox Text="{Binding Filter}" PlaceholderText="Filter by name, title ID or region" Margin="0,0,0,8" />

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding Bases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BaseRowViewModel">
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Classes="base-name" Text="{Binding Name}" />
                                            <TextBlock Classes="base-region" Text="{Binding Region}" />
                                            <TextBlock Classes="base-id mono" Text="{Binding TitleId}" />
                                            <TextBlock Classes="base-id" Text="(custom)" IsVisible="{Binding IsCustom}" />
                                            <Button Classes="link" Command="{Binding $parent[ItemsControl].((vm:BasesViewModel)DataContext).RemoveCustomBaseCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsCustom}" ToolTip.Tip="Forget this base; its files stay in the base store">
                                                <TextBlock Text="Forget" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="hint" Text="Title key" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Classes="mono title-key" Text="{Binding TitleKey}" PlaceholderText="32 hex characters; empty to clear" />
                                            <Border Grid.Column="2" Classes="check" Classes.on="{Binding IsTitleKeyVerified}" ToolTip.Tip="{Binding TitleKeyHint}">
                                                <TextBlock Text="✓" IsVisible="{Binding IsTitleKeyVerified}" />
                                            </Border>
                                        </Grid>
                                        <!-- Actions sit under the key they depend on -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Classes="sm primary" Content="Download" Command="{Binding DownloadCommand}" IsVisible="{Binding !DownloadCommand.IsRunning}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding DownloadHint}" />
                                            <Button Classes="sm ghost" Content="Cancel" Command="{Binding DownloadCancelCommand}" IsVisible="{Binding DownloadCommand.IsRunning}" />
                                            <Button Classes="sm" Content="Inspect" Command="{Binding InspectCommand}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding InspectHint}" />
                                        </StackPanel>
                                        <TextBlock Classes="hint" Text="{Binding ProgressText}" IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Custom base -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock FontSize="13" FontWeight="Bold" Text="Custom base" Margin="0,0,0,4" />
                        <TextBlock Classes="hint" Margin="0,0,0,10"
                                   Text="{Binding SelectedConsole, Converter={x:Static conv:ConsoleConverters.Name}, StringFormat='Adds a title the catalog does not list, for {0}. Pick its folder to bring the files in: an unpacked title (code, content, meta) or an installable package (title.tmd and .app files); the fields fill in from it. Without a folder the base is registered only, to download with its title key.'}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                            <TextBox Grid.Column="0" Text="{Binding CustomFolder}" IsReadOnly="True" PlaceholderText="No folder; register only" />
                            <Button Grid.Column="1" Classes="sm" Content="Pick folder…" Command="{Binding PickCustomFolderCommand}" />
                            <Button Grid.Column="2" Classes="sm ghost" Content="Clear" Command="{Binding ClearCustomFolderCommand}" IsVisible="{Binding HasCustomFolder}" />
                        </Grid>
                        <TextBlock Classes="hint" Margin="0,0,0,10" Text="{Binding CustomFolderHint}" IsVisible="{Binding HasCustomFolder}" />
                        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4" MinWidth="180">
                                <TextBlock Classes="label" Text="Title ID" />
                                <TextBox Classes="mono" Text="{Binding CustomTitleId}" PlaceholderText="0005000010100000" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" MinWidth="160">
                                <TextBlock Classes="label" Text="Name" />
                                <TextBox Text="{Binding CustomName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" MinWidth="130">
                                <TextBlock Classes="label" Text="Region" />
                                <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding CustomRegion}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Button Grid.Column="3" Classes="sm" Content="Add" Command="{Binding AddCustomBaseCommand}" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock Classes="hint" Margin="0,8,0,0" Text="{Binding CustomProgress}" IsVisible="{Binding CustomProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
