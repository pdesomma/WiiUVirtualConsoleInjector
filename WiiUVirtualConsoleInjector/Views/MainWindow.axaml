<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
        xmlns:conv="using:WiiUVirtualConsoleInjector.Converters"
        x:Class="WiiUVirtualConsoleInjector.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1280" Height="824" MinWidth="1000" MinHeight="660"
        Background="{DynamicResource PageBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Window.Styles>
        <Style Selector="Button.knob">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Shell" CornerRadius="9999" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.knob.on /template/ Border#PART_Shell">
            <Setter Property="Background" Value="#38FFFFFF" />
        </Style>
    </Window.Styles>

    <Panel>
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Height="58" Background="{DynamicResource HeaderBrush}" BoxShadow="0 2 6 0 #40000000" ZIndex="1">
            <DockPanel Margin="22,0">
                <Image DockPanel.Dock="Left" Source="/Assets/wiiu.png" Width="26" Height="26" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Foreground="{DynamicResource HeaderTextBrush}" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="12,0,0,0" />

                <!-- New release -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="14,0,0,0" IsVisible="{Binding Update.IsAvailable}">
                    <Button Classes="link" Command="{Binding Update.OpenCommand}" ToolTip.Tip="Open the release page">
                        <TextBlock Text="{Binding Update.Text}" Foreground="{DynamicResource HeaderTextBrush}" FontSize="12.5" FontWeight="Bold" />
                    </Button>
                    <Button Classes="toast-close" Content="&#xD7;" Command="{Binding Update.DismissCommand}" Foreground="{DynamicResource HeaderTextBrush}" ToolTip.Tip="Not now" />
                </StackPanel>

                <!-- Light / dark toggle -->
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9999" Background="#1AFFFFFF" Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="knob" Classes.on="{Binding IsLight}" Command="{Binding UseLightCommand}" ToolTip.Tip="Light">
                            <Ellipse Width="18" Height="18" Fill="White" Opacity="{Binding IsLight, Converter={x:Static conv:BoolConverters.OpacityOn}}" />
                        </Button>
                        <Button Classes="knob" Classes.on="{Binding IsDark}" Command="{Binding UseDarkCommand}" ToolTip.Tip="Dark">
                            <Panel Width="16" Height="16" ClipToBounds="True" Opacity="{Binding IsDark, Converter={x:Static conv:BoolConverters.OpacityOn}}">
                                <Ellipse Fill="#DBE4EA" />
                                <Ellipse Width="14" Height="14" Fill="#3A3A38" Margin="7,-6,-5,0" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </Border>
                <Panel />
            </DockPanel>
        </Border>

        <!-- Nav rail -->
        <Border DockPanel.Dock="Left" Width="90" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource RailBorderBrush}" BorderThickness="0,0,1,0">
            <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" Margin="0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageViewModel">
                        <StackPanel>
                            <Panel IsVisible="{Binding !HasNavGlyph}">
                                <Image Source="{Binding NavIcon, Converter={x:Static conv:AssetConverter.Bitmap}}" IsVisible="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).IsDark}" HorizontalAlignment="Center" />
                                <Image Source="{Binding NavIconDark, Converter={x:Static conv:AssetConverter.Bitmap}}" IsVisible="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).IsLight}" HorizontalAlignment="Center" />
                            </Panel>
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" IsVisible="{Binding HasNavGlyph}">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="nav-glyph" Data="{Binding NavGlyph, Converter={x:Static conv:GeometryConverter.Parse}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Content -->
        <Border Background="{DynamicResource PageGradientBrush}">
            <Panel>
                <ScrollViewer Padding="24,20">
                    <ContentControl Content="{Binding CurrentPage}" />
                </ScrollViewer>

                <!-- Side arrows: the mockup's glossy chevron, pinned to the middle of the view so scrolling never hides them -->
                <Button Classes="arrow" Command="{Binding Arrows.PreviousCommand}" IsVisible="{Binding HasArrows}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" ToolTip.Tip="{Binding Arrows.PreviousHint}">
                    <Viewbox Width="76" Height="130" RenderTransformOrigin="50%,50%">
                        <Viewbox.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Viewbox.RenderTransform>
                        <Canvas Width="200" Height="300">
                            <Path Classes="arrow-top" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 120, 50 150 L 180 150 Z" />
                            <Path Classes="arrow-bottom" Data="M 50 150 C 55 180, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                            <Path Classes="arrow-edge" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Classes="arrow" Command="{Binding Arrows.NextCommand}" IsVisible="{Binding HasArrows}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0" ToolTip.Tip="{Binding Arrows.NextHint}">
                    <Viewbox Width="76" Height="130">
                        <Canvas Width="200" Height="300">
                            <Path Classes="arrow-top" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 120, 50 150 L 180 150 Z" />
                            <Path Classes="arrow-bottom" Data="M 50 150 C 55 180, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                            <Path Classes="arrow-edge" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Panel>
        </Border>
    </DockPanel>

    <!-- Toasts: newest at the bottom, anchored to the window's bottom-right corner -->
    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" ZIndex="2">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToastViewModel">
                <Border Classes="toast" Classes.entering="{Binding IsEntering}" Classes.leaving="{Binding IsLeaving}">
                    <DockPanel>
                        <Border Classes="toast-stripe" DockPanel.Dock="Left" Background="{Binding Kind, Converter={x:Static conv:ToastConverters.Stripe}}" />
                        <Button Classes="toast-close" DockPanel.Dock="Right" Content="&#xD7;" Margin="8,11,12,0" Command="{Binding DismissCommand}" ToolTip.Tip="Close" />
                        <StackPanel Margin="14,13,0,13" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="ExtraBold" LineHeight="17" />
                            <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Panel>
</Window>
