<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels.Options"
             x:Class="WiiUVirtualConsoleInjector.Views.Options.NdsOptionsView"
             x:DataType="vm:NdsOptionsViewModel">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Brightness" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Brightness}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{Binding Brightness, StringFormat='{}{0} %'}" MinWidth="48" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Pixel art upscaler" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="64" Increment="1" FormatString="0" Value="{Binding PixelArtUpscaler}" Width="140" HorizontalAlignment="Left" />
        </Grid>
        <ContentControl Content="{Binding LayoutScreens}" />
    </StackPanel>
</UserControl>
