<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels.Options"
             x:Class="WiiUVirtualConsoleInjector.Views.Options.GbaOptionsView"
             x:DataType="vm:GbaOptionsViewModel">
    <StackPanel Spacing="16" Width="560" HorizontalAlignment="Left">
        <CheckBox Content="Pokémon save patch" IsChecked="{Binding PokemonPatch}" />
        <CheckBox Content="Remove dark filter" IsChecked="{Binding RemoveDarkFilter}" />
    </StackPanel>
</UserControl>
