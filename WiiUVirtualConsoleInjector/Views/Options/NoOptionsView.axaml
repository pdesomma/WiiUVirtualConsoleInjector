<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels.Options"
             x:Class="WiiUVirtualConsoleInjector.Views.Options.NoOptionsView"
             x:DataType="vm:NoOptionsViewModel">
    <TextBlock Text="This console has no adjustable options." FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,36" />
</UserControl>
