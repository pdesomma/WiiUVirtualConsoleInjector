<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels.Options"
             x:Class="WiiUVirtualConsoleInjector.Views.Options.N64OptionsView"
             x:DataType="vm:N64OptionsViewModel">
    <StackPanel Spacing="8">
        <ContentControl Content="{Binding Ini}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Display" />
            <CheckBox Grid.Row="0" Grid.Column="1" Content="Remove dark filter" IsChecked="{Binding RemoveDarkFilter}" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="Widescreen" IsChecked="{Binding WideScreen}" />
        </Grid>
    </StackPanel>
</UserControl>
