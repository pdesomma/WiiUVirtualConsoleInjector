<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels.Options"
             x:Class="WiiUVirtualConsoleInjector.Views.Options.NesOptionsView"
             x:DataType="vm:NesOptionsViewModel">
    <Grid ColumnDefinitions="180,*" ColumnSpacing="8" RowSpacing="8">
        <TextBlock Grid.Column="0" Classes="label" Text="Scaling" />
        <CheckBox Grid.Column="1" Content="Pixel perfect (integer scaling)" IsChecked="{Binding PixelPerfect}" />
    </Grid>
</UserControl>
