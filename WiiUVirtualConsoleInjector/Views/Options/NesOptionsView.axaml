<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels.Options"
             x:Class="WiiUVirtualConsoleInjector.Views.Options.NesOptionsView"
             x:DataType="vm:NesOptionsViewModel">
    <StackPanel Spacing="16" Width="560" HorizontalAlignment="Left">
        <CheckBox Content="Pixel perfect (integer scaling)" IsChecked="{Binding PixelPerfect}" />
    </StackPanel>
</UserControl>
