<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:WiiUVirtualConsoleInjector.Converters"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             x:Class="WiiUVirtualConsoleInjector.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.DataTemplates>
        <!-- One folder: label above, read-only path with Browse and Reset -->
        <DataTemplate x:DataType="vm:FolderSettingViewModel">
            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{Binding Label}" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="sm" Content="Browse…" Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="2" Classes="sm icon" Command="{Binding OpenCommand}" ToolTip.Tip="Show in the file manager">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Classes="btn-glyph" Data="M3 7a1 1 0 0 1 1-1h5l2 2.5h9a1 1 0 0 1 1 1V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="3" Classes="sm icon ghost" Command="{Binding ResetCommand}" ToolTip.Tip="Reset to default">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Classes="btn-glyph" Data="M19.5 12a7.5 7.5 0 1 1-2.2-5.3 M19.5 4v4h-4" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:DataType="vm:WarningSettingViewModel">
            <CheckBox IsChecked="{Binding ShowAgain}" VerticalContentAlignment="Top">
                <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
            </CheckBox>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="820" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="20">

            <!-- Paths -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Paths" />
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Artwork -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Artwork" Margin="0,0,0,4" />
                    <TextBlock Classes="hint" FontSize="12" Text="Generated boot screens are lettered in this font. The previous application's font.otf is picked up when it is on this machine." Margin="0,0,0,12" TextWrapping="Wrap" />
                    <StackPanel Spacing="4" DataContext="{Binding CaptionFont}">
                        <TextBlock Classes="label" Text="Caption font" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="sm" Content="Browse…" Command="{Binding BrowseCommand}" />
                            <Button Grid.Column="2" Classes="sm icon ghost" Command="{Binding ResetCommand}" IsEnabled="{Binding IsChosen}" ToolTip.Tip="Forget the chosen file">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Classes="btn-glyph" Data="M19.5 12a7.5 7.5 0 1 1-2.2-5.3 M19.5 4v4h-4" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SD card -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="SD card" Margin="0,0,0,4" />
                    <TextBlock Classes="hint" FontSize="12" Text="Picked up from the removable drives; the Wii U card is the one with a wiiu or install folder." Margin="0,0,0,12" />
                    <StackPanel Spacing="4" DataContext="{Binding SdCard}">
                        <TextBlock Classes="label" Text="Drive" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" HorizontalAlignment="Stretch" PlaceholderText="No removable drive found" />
                            <Button Grid.Column="1" Classes="sm icon" Command="{Binding RescanCommand}" ToolTip.Tip="Scan for drives again">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Classes="btn-glyph" Data="M19.5 12a7.5 7.5 0 1 1-2.2-5.3 M19.5 4v4h-4" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="2" Classes="sm icon" Command="{Binding OpenCommand}" IsEnabled="{Binding HasCard}" ToolTip.Tip="Show the install folder">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Classes="btn-glyph" Data="M3 7a1 1 0 0 1 1-1h5l2 2.5h9a1 1 0 0 1 1 1V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding Status}" Margin="0,1,0,10" />
                        <CheckBox IsChecked="{Binding CopyAfterInject}" IsEnabled="{Binding HasCard}">
                            <TextBlock Text="Copy each finished title to the card's install folder" FontSize="12.5" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Nintendont -->
            <Border Classes="card">
                <StackPanel DataContext="{Binding Nintendont}" Spacing="10">
                    <TextBlock Classes="section" Text="Nintendont" Margin="0,0,0,-6" />
                    <TextBlock Classes="hint" FontSize="12" Text="GameCube injects boot through Nintendont on the SD card; it needs apps/nintendont/boot.dol and a nincfg.bin at the root. The settings here are what every GameCube inject runs with." TextWrapping="Wrap" />
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="12.5" Text="{Binding LoaderStatus}" TextWrapping="Wrap" />
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding ConfigStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary sm" Content="Put Nintendont on the card" Command="{Binding InstallCommand}" />
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding Progress}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding HasCard}">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="label" Text="Video" />
                            <ComboBox ItemsSource="{Binding Videos}" SelectedItem="{Binding Video}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Object">
                                        <TextBlock Text="{Binding, Converter={x:Static conv:NintendontConverters.VideoLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" IsEnabled="{Binding IsForcing}">
                            <TextBlock Classes="label" Text="Forced mode" />
                            <ComboBox ItemsSource="{Binding ForcedModes}" SelectedItem="{Binding ForcedMode}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Object">
                                        <TextBlock Text="{Binding, Converter={x:Static conv:NintendontConverters.ForcedModeLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <WrapPanel ItemSpacing="16" LineSpacing="6" IsEnabled="{Binding HasCard}">
                        <CheckBox Content="Progressive" IsChecked="{Binding Progressive}" />
                        <CheckBox Content="Force progressive" IsChecked="{Binding ForceProgressive}" />
                        <CheckBox Content="Patch PAL50" IsChecked="{Binding PatchPal50}" />
                        <CheckBox Content="Force widescreen" IsChecked="{Binding ForceWidescreen}" />
                        <CheckBox Content="Wii U widescreen" IsChecked="{Binding WiiUWidescreen}" />
                        <CheckBox Content="Remove 480p limit" IsChecked="{Binding RemoveLimit}" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsEnabled="{Binding HasCard}">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="label" Text="Language" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="label" Text="Controllers" />
                            <NumericUpDown Value="{Binding Pads}" Minimum="0" Maximum="4" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" IsEnabled="{Binding MemoryCardEmulation}">
                            <TextBlock Classes="label" Text="Memory card size" />
                            <ComboBox ItemsSource="{Binding MemoryCardSizes}" SelectedItem="{Binding MemoryCardSize}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Object">
                                        <TextBlock Text="{Binding, Converter={x:Static conv:NintendontConverters.MemoryCardLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <WrapPanel ItemSpacing="16" LineSpacing="6" IsEnabled="{Binding HasCard}">
                        <CheckBox Content="Emulate memory card" IsChecked="{Binding MemoryCardEmulation}" />
                        <CheckBox Content="One card for every game" IsChecked="{Binding MemoryCardShared}" IsEnabled="{Binding MemoryCardEmulation}" />
                        <CheckBox Content="Cheats (sd:/codes)" IsChecked="{Binding Cheats}" />
                        <CheckBox Content="Skip boot animation" IsChecked="{Binding SkipIpl}" />
                        <CheckBox Content="Classic Controller rumble" IsChecked="{Binding ClassicControllerRumble}" />
                        <CheckBox Content="Arcade mode" IsChecked="{Binding ArcadeMode}" />
                        <CheckBox Content="Broadband adapter" IsChecked="{Binding BroadbandEmulation}" />
                    </WrapPanel>
                    <Button Classes="sm" Content="Write nincfg.bin" Command="{Binding WriteConfigCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Previous application -->
            <Border Classes="card" IsVisible="{Binding Legacy.HasInstall}">
                <StackPanel DataContext="{Binding Legacy}" Spacing="10">
                    <TextBlock Classes="section" Text="UWUVCI AIO" Margin="0,0,0,-6" />
                    <TextBlock Classes="hint" FontSize="12" Text="The previous application is on this machine. Its keys and downloaded bases can be taken over; nothing already here is replaced, and nothing of its own is touched." TextWrapping="Wrap" />
                    <TextBlock FontSize="12.5" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Classes="hint mono" FontSize="11.5" Text="{Binding Location}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary sm" Content="Take it over" Command="{Binding ImportCommand}" />
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding Progress}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontSize="12.5" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Classes="card">
                <StackPanel DataContext="{Binding Update}" Spacing="10">
                    <TextBlock Classes="section" Text="Updates" Margin="0,0,0,-6" />
                    <TextBlock Classes="hint" FontSize="12" Text="{Binding CurrentText}" />
                    <CheckBox IsChecked="{Binding CheckAtStartup}">
                        <TextBlock Text="Look for a newer release on GitHub when the application starts" FontSize="12.5" TextWrapping="Wrap" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="sm" Content="Check now" Command="{Binding CheckNowCommand}" />
                        <Button Classes="link" Command="{Binding OpenCommand}" IsVisible="{Binding IsAvailable}">
                            <TextBlock Text="Open the release page" />
                        </Button>
                        <TextBlock Classes="hint" FontSize="12" Text="{Binding Status}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Warnings -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section" Text="Warnings" Margin="0,0,0,4" />
                    <TextBlock Classes="hint" FontSize="12" Text="Show these warnings again before injecting:" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Data folder -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Bold" Text="Data folder" Margin="0,0,0,4" />
                    <TextBlock Classes="hint" FontSize="12" Text="Settings, keys and caches live here." Margin="0,0,0,8" />
                    <SelectableTextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DataFolder}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
