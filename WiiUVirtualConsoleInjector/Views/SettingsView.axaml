<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             x:Class="WiiUVirtualConsoleInjector.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:FolderSettingViewModel">
            <Grid ColumnDefinitions="180,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" />
                <TextBox Grid.Column="1" Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" />
                <Button Grid.Column="3" Content="Reset to default" Command="{Binding ResetCommand}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:DataType="vm:WarningSettingViewModel">
            <CheckBox IsChecked="{Binding ShowAgain}" Content="{Binding Description}" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel Spacing="12" MaxWidth="960" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/settings.png" Classes="glyph" Width="26" Height="26" Margin="0,0,10,8" />
            <TextBlock Classes="title" Text="{Binding Title}" />
        </StackPanel>

        <!-- Folders -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Folders" />
                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Warnings -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Warnings" />
                <TextBlock Classes="hint" Text="Show these warnings again before injecting:" />
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Data folder -->
        <StackPanel Spacing="4" Margin="4,0">
            <TextBlock Classes="hint" Text="Settings, keys and caches live here:" />
            <SelectableTextBlock Text="{Binding DataFolder}" FontSize="12" Opacity="0.65" FontFamily="Consolas,monospace" />
        </StackPanel>
    </StackPanel>
</UserControl>
