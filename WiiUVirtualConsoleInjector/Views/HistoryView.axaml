<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             xmlns:conv="using:WiiUVirtualConsoleInjector.Converters"
             x:Class="WiiUVirtualConsoleInjector.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <UserControl.Styles>
        <!-- Wii U menu tile: the icon in a rounded frame, name underneath -->
        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.tile:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <!-- Glass frame: a rounded pane of translucent white that catches the light at the top, like the Wii U menu -->
        <Style Selector="Border.tile-frame">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="128" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TileEdgeBrush}" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="{DynamicResource TileGlassTop}" />
                    <GradientStop Offset="0.5" Color="{DynamicResource TileGlassMiddle}" />
                    <GradientStop Offset="1" Color="{DynamicResource TileGlassBottom}" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 4 10 0 #2E000000, inset 0 1 0 0 #B3FFFFFF" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.tile:pointerover Border.tile-frame">
            <Setter Property="BorderBrush" Value="{DynamicResource CyanFocusBrush}" />
            <Setter Property="BoxShadow" Value="0 0 0 2 #8000AACC, 0 5 14 0 #38000000, inset 0 1 0 0 #B3FFFFFF" />
        </Style>
        <Style Selector="Border.tile-icon">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33000000" />
        </Style>
        <!-- Sheen across the top of the icon -->
        <Style Selector="Border.tile-sheen">
            <Setter Property="CornerRadius" Value="12,12,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Height" Value="52" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#66FFFFFF" />
                    <GradientStop Offset="1" Color="#0AFFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.tile-name">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="150" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.tile-meta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tile-badge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource TileFrameBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-4,-4" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <StackPanel Spacing="14" MaxWidth="900" Margin="80,0" HorizontalAlignment="Stretch">
            <!-- Page dots, the wizard's -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ListBox Classes="dots" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" HorizontalAlignment="Center" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryPage">
                            <Border Classes="dot" ToolTip.Tip="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding PageLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" LetterSpacing="0.2" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Classes="card" MinHeight="560">
                <Panel>
                    <!-- Empty -->
                    <StackPanel IsVisible="{Binding IsEmpty}" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="Nothing here yet" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Every title you inject shows up here as a tile. Pick one to load it back into the wizard, tweak anything, and build it again with the same IDs." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Tiles -->
                    <ItemsControl ItemsSource="{Binding Current}" IsVisible="{Binding !IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                                <Button Classes="tile" Width="200" Height="176" Margin="2"
                                        Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).LoadCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Tooltip}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Load into the wizard" Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).LoadCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Forget" Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).ForgetCommand}" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Panel Width="136" Height="136" HorizontalAlignment="Center">
                                            <Border Classes="tile-frame" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Classes="tile-icon">
                                                    <Panel>
                                                        <Image Source="{Binding IconPath, Converter={x:Static conv:FileImageConverter.Bitmap}}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                                                        <Panel IsVisible="{Binding !HasIcon}" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                                                            <Image Source="{Binding Console, Converter={x:Static conv:ConsoleConverters.Icon}}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsDark}" />
                                                            <Image Source="{Binding Console, Converter={x:Static conv:ConsoleConverters.DarkIcon}}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsLight}" />
                                                        </Panel>
                                                        <Border Classes="tile-sheen" />
                                                    </Panel>
                                                </Border>
                                            </Border>
                                            <!-- Console badge -->
                                            <Border Classes="tile-badge" ToolTip.Tip="{Binding ConsoleName}">
                                                <Panel>
                                                    <Image Source="{Binding Console, Converter={x:Static conv:ConsoleConverters.Icon}}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsDark}" />
                                                    <Image Source="{Binding Console, Converter={x:Static conv:ConsoleConverters.DarkIcon}}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsLight}" />
                                                </Panel>
                                            </Border>
                                        </Panel>
                                        <TextBlock Classes="tile-name" Text="{Binding Name}" />
                                        <TextBlock Classes="tile-meta" Text="{Binding When}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>
