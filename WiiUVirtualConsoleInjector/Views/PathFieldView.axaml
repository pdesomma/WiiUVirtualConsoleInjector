<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             xmlns:conv="using:WiiUVirtualConsoleInjector.Converters"
             x:Class="WiiUVirtualConsoleInjector.Views.PathFieldView"
             x:DataType="vm:PathFieldViewModel">
    <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Classes="glyph" Source="{Binding Glyph, Converter={x:Static conv:AssetConverter.Bitmap}}" IsVisible="{Binding Glyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="label" Text="{Binding Label}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding Path}" IsReadOnly="True" PlaceholderText="Optional" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="sm" Content="Pick" Command="{Binding PickCommand}" />
            <Button Grid.Column="2" Classes="ghost sm" Content="Clear" Command="{Binding ClearCommand}" />
        </Grid>
        <TextBlock Classes="fine" Text="{Binding Hint}" IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
