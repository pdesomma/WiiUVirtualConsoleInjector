<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             x:Class="WiiUVirtualConsoleInjector.Views.PathFieldView"
             x:DataType="vm:PathFieldViewModel">
    <Grid ColumnDefinitions="160,*,Auto,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" />
            <TextBlock Text="{Binding Hint}" IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" Opacity="0.7" />
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding Path}" IsReadOnly="True" PlaceholderText="Optional" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="Pick" Command="{Binding PickCommand}" MinWidth="70" />
        <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" MinWidth="70" />
    </Grid>
</UserControl>
