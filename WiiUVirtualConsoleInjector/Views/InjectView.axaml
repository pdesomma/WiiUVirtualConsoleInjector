<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             x:Class="WiiUVirtualConsoleInjector.Views.InjectView"
             x:DataType="vm:InjectViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="24" />

        <TextBlock Classes="section" Text="Console and base" />
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Console" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Consoles}" SelectedItem="{Binding SelectedConsole}" MinWidth="240" IsEnabled="{Binding !IsRunning}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Base" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsRunning}">
                <ComboBox.ItemContainerTheme>
                    <ControlTheme TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}" x:DataType="vm:BaseChoice">
                        <Setter Property="IsEnabled" Value="{Binding IsPresent}" />
                    </ControlTheme>
                </ComboBox.ItemContainerTheme>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BaseChoice">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint" Text="{Binding BaseHint}" IsVisible="{Binding BaseHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

        <TextBlock Classes="section" Text="ROM" />
        <Grid ColumnDefinitions="160,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="label" Text="ROM" />
            <TextBox Grid.Column="1" Text="{Binding RomPath}" IsReadOnly="True" PlaceholderText="Required" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Pick ROM" Command="{Binding PickRomCommand}" IsEnabled="{Binding !IsRunning}" />
            <Button Grid.Column="3" Content="Pick TurboCD folder" Command="{Binding PickTurboCdFolderCommand}" IsVisible="{Binding IsTurboCd}" IsEnabled="{Binding !IsRunning}" />
        </Grid>

        <TextBlock Classes="section" Text="Game" />
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Name" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" PlaceholderText="Required" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Text="A comma splits a long name into lines; the text before it is the short name." />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Product ID" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProductId}" MaxLength="4" Width="120" HorizontalAlignment="Left" PlaceholderText="Optional, 4 characters" />

            <CheckBox Grid.Row="3" Grid.Column="1" Content="Use the GamePad as a controller" IsChecked="{Binding GamePad}" IsVisible="{Binding IsGamePadVisible}" />
        </Grid>

        <TextBlock Classes="section" Text="Artwork" />
        <ContentControl Content="{Binding Icon}" />
        <ContentControl Content="{Binding BootTv}" />
        <ContentControl Content="{Binding BootDrc}" />
        <ContentControl Content="{Binding BootLogo}" />
        <ContentControl Content="{Binding BootSound}" />

        <TextBlock Classes="section" Text="Options" />
        <ContentControl Content="{Binding CurrentOptions}" />

        <TextBlock Classes="section" Text="Inject" />
        <TextBlock Classes="hint" Text="{Binding MissingKeysHint}" IsVisible="{Binding HasMissingKeys}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Inject" Command="{Binding InjectCommand}" MinWidth="120" Classes="accent" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="120" />
            <TextBlock Classes="label" Text="{Binding Status}" />
            <TextBlock Classes="label" Text="{Binding CurrentStep}" Opacity="0.7" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
        <ListBox ItemsSource="{Binding Log}" Height="180" IsVisible="{Binding !!Log.Count}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="12" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
