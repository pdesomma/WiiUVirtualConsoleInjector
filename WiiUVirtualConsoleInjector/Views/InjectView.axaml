<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             xmlns:vm2="using:PD.WiiU.VirtualConsole"
             xmlns:conv="using:WiiUVirtualConsoleInjector.Converters"
             x:Class="WiiUVirtualConsoleInjector.Views.InjectView"
             x:DataType="vm:InjectViewModel">

    <StackPanel Spacing="12" MaxWidth="960" HorizontalAlignment="Left">
        <TextBlock Classes="title" Text="{Binding Title}" />

        <!-- Console picker -->
        <ListBox Classes="consoles" ItemsSource="{Binding Consoles}" SelectedItem="{Binding SelectedConsole}" IsEnabled="{Binding !IsRunning}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm2:SourceConsole">
                    <Image Source="{Binding, Converter={x:Static conv:ConsoleConverters.Icon}}"
                           ToolTip.Tip="{Binding, Converter={x:Static conv:ConsoleConverters.Name}}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Base -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Base" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Base" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsRunning}">
                        <ComboBox.ItemContainerTheme>
                            <ControlTheme TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}" x:DataType="vm:BaseChoice">
                                <Setter Property="IsEnabled" Value="{Binding IsPresent}" />
                            </ControlTheme>
                        </ComboBox.ItemContainerTheme>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BaseChoice">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Text="{Binding BaseHint}" IsVisible="{Binding BaseHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROM -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="ROM" />
                <Grid ColumnDefinitions="180,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Classes="label" Text="ROM" />
                    <TextBox Grid.Column="1" Text="{Binding RomPath}" IsReadOnly="True" PlaceholderText="Required" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Pick ROM" Command="{Binding PickRomCommand}" IsEnabled="{Binding !IsRunning}" />
                    <Button Grid.Column="3" Content="Pick TurboCD folder" Command="{Binding PickTurboCdFolderCommand}" IsVisible="{Binding IsTurboCd}" IsEnabled="{Binding !IsRunning}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Game -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Game" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Name" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" PlaceholderText="Required" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Text="A comma splits a long name into lines; the text before it is the short name." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Product ID" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProductId}" MaxLength="4" Width="120" HorizontalAlignment="Left" PlaceholderText="Optional, 4 characters" />

                    <CheckBox Grid.Row="3" Grid.Column="1" Content="Use the GamePad as a controller" IsChecked="{Binding GamePad}" IsVisible="{Binding IsGamePadVisible}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Artwork -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Artwork" />
                <ContentControl Content="{Binding Icon}" />
                <ContentControl Content="{Binding BootTv}" />
                <ContentControl Content="{Binding BootDrc}" />
                <ContentControl Content="{Binding BootLogo}" />
                <ContentControl Content="{Binding BootSound}" />
            </StackPanel>
        </Border>

        <!-- Options -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Options" />
                <ContentControl Content="{Binding CurrentOptions}" />
            </StackPanel>
        </Border>

        <!-- Action area -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="hint" Text="{Binding MissingKeysHint}" IsVisible="{Binding HasMissingKeys}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Content="Inject" Command="{Binding InjectCommand}" MinWidth="120" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="120" VerticalAlignment="Center" />
                    <TextBlock Classes="label" Text="{Binding Status}" />
                    <TextBlock Classes="label" Text="{Binding CurrentStep}" Opacity="0.6" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
                <ListBox ItemsSource="{Binding Log}" Height="180" IsVisible="{Binding !!Log.Count}"
                         Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas,monospace" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
