<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiUVirtualConsoleInjector.ViewModels"
             xmlns:vc="using:PD.WiiU.VirtualConsole"
             xmlns:wiiu="using:WiiUSharp"
             xmlns:conv="using:WiiUVirtualConsoleInjector.Converters"
             xmlns:behaviors="using:WiiUVirtualConsoleInjector.Behaviors"
             x:Class="WiiUVirtualConsoleInjector.Views.InjectView"
             x:DataType="vm:InjectViewModel">

    <UserControl.Styles>
        <!-- Inline link styled as text -->
        <Style Selector="Button.link">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.link TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource CyanDarkBrush}" />
        </Style>

        <!-- Clickable artwork slot -->
        <Style Selector="Button.slot">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.slot:pointerover Rectangle.slot-frame">
            <Setter Property="Stroke" Value="{DynamicResource CyanFocusBrush}" />
        </Style>
        <Style Selector="Rectangle.slot-frame">
            <Setter Property="Fill" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="4,3" />
        </Style>
        <Style Selector="Button.tiny">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,3" />
        </Style>

        <!-- Stroke glyphs in the base list -->
        <Style Selector="Path.glyph">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>

        <!-- Review summary -->
        <Style Selector="TextBlock.summary-label">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Width" Value="90" />
        </Style>
        <Style Selector="TextBlock.summary-value">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Wizard column -->
        <StackPanel Spacing="14" MaxWidth="900" Margin="80,0" HorizontalAlignment="Stretch">
            <!-- Step dots -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <ListBox Classes="dots" ItemsSource="{x:Static vm:InjectViewModel.Steps}" SelectedItem="{Binding SelectedStep}" HorizontalAlignment="Center" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:WizardStep">
                            <Border Classes="dot" ToolTip.Tip="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding CurrentWizardStep.Label}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" LetterSpacing="0.2" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Classes="card">
                <Panel>
                    <!-- 1. Console -->
                    <StackPanel IsVisible="{Binding IsConsoleStep}">
                        <TextBlock Classes="section" Text="Choose the source console" />
                        <ListBox Classes="tiles" ItemsSource="{Binding Consoles}" SelectedItem="{Binding SelectedConsole}" IsEnabled="{Binding !IsRunning}"
                                 MaxWidth="456" Padding="0" HorizontalAlignment="Center">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vc:SourceConsole">
                                    <StackPanel>
                                        <Border Classes="tile-frame">
                                            <Panel>
                                                <Border Classes="tile-panel">
                                                    <Image Classes="tile-logo" Source="{Binding, Converter={x:Static conv:ConsoleConverters.DarkIcon}}" Opacity="0.8" />
                                                </Border>
                                                <Border Classes="tile-gloss" />
                                            </Panel>
                                        </Border>
                                        <TextBlock Classes="tile-label" Text="{Binding, Converter={x:Static conv:ConsoleConverters.Name}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- 2. Base -->
                    <StackPanel IsVisible="{Binding IsBaseStep}">
                        <TextBlock Classes="section" Text="{Binding SelectedConsoleName, StringFormat='Base for {0}'}" Margin="0,0,0,4" />
                        <TextBlock Classes="hint" FontSize="12" Text="The base holds the Virtual Console emulator; your ROM gets patched into it." Margin="0,0,0,14" />
                        <ComboBox ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}" Width="480" HorizontalAlignment="Left" IsEnabled="{Binding !IsRunning}" PlaceholderText="Select a base…">
                            <ComboBox.ItemContainerTheme>
                                <ControlTheme TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}" x:DataType="vm:BaseChoice">
                                    <Setter Property="Opacity" Value="{Binding IsUsable, Converter={x:Static conv:StatusConverters.UsableOpacity}}" />
                                </ControlTheme>
                            </ComboBox.ItemContainerTheme>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BaseChoice">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Width="22" Height="15" CornerRadius="2" BorderThickness="1" BorderBrush="#26000000" VerticalAlignment="Center"
                                                Background="{Binding Base.Region, Converter={x:Static conv:RegionConverters.Flag}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Base.Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="mono" Text="{Binding TitleId}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <Viewbox Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center" ToolTip.Tip="Common key">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="glyph" Stroke="{Binding KeysOk, Converter={x:Static conv:StatusConverters.Glyph}}"
                                                      Data="M12 8 A4 4 0 1 1 4 8 A4 4 0 1 1 12 8 M10.8 10.8L20 20 M15.5 15.5l2.2 -2.2 M18 18l2.2 -2.2" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox Grid.Column="3" Width="16" Height="16" VerticalAlignment="Center" ToolTip.Tip="Downloaded">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="glyph" Stroke="{Binding IsPresent, Converter={x:Static conv:StatusConverters.Glyph}}"
                                                      Data="M12 3v11 M7.5 10.5L12 15l4.5-4.5 M4 17.5V19a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1.5" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel ItemSpacing="6" Margin="0,12,0,0" IsVisible="{Binding BaseHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="warning" Text="{Binding BaseHint}" VerticalAlignment="Center" />
                            <Button Classes="link" Command="{Binding ManageBasesCommand}">
                                <TextBlock Text="Manage bases &amp; keys →" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 3. Game -->
                    <StackPanel IsVisible="{Binding IsGameStep}">
                        <TextBlock Classes="section" Text="Game" />
                        <StackPanel Spacing="16" Width="560" HorizontalAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="ROM" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                    <TextBox Grid.Column="0" Text="{Binding RomPath}" IsReadOnly="True" PlaceholderText="Required" />
                                    <Button Grid.Column="1" Classes="sm" Content="Pick ROM" Command="{Binding PickRomCommand}" IsEnabled="{Binding !IsRunning}" />
                                    <Button Grid.Column="2" Classes="sm" Content="Pick TurboCD folder" Command="{Binding PickTurboCdFolderCommand}" IsVisible="{Binding IsTurboCd}" IsEnabled="{Binding !IsRunning}" />
                                    <Button Grid.Column="3" Classes="ghost sm" Content="Clear" Command="{Binding ClearRomCommand}" IsVisible="{Binding HasRom}" IsEnabled="{Binding !IsRunning}" />
                                </Grid>
                                <TextBlock Classes="hint" Text="{Binding RomExtensions, StringFormat='Accepts {0}'}" Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Long name" />
                                <TextBox Text="{Binding Name}" PlaceholderText="Required" IsEnabled="{Binding !IsRunning}" />
                                <TextBlock Classes="hint" Text="Shown on the title's own page; a comma splits it into lines." Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Short name" />
                                <TextBox Text="{Binding ShortName}" PlaceholderText="Optional" IsEnabled="{Binding !IsRunning}" />
                                <TextBlock Classes="hint" Text="Shown under the icon on the Wii U menu; defaults to the long name's first line." Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Product ID" />
                                <TextBox Classes="mono" Text="{Binding ProductId}" MaxLength="4" Width="120" HorizontalAlignment="Left" PlaceholderText="Optional" IsEnabled="{Binding !IsRunning}" />
                                <TextBlock Classes="hint" Text="Optional, 4 characters" Margin="0,1,0,0" />
                            </StackPanel>
                            <CheckBox Content="Use the GamePad as a controller" IsChecked="{Binding GamePad}" IsVisible="{Binding IsGamePadVisible}" IsEnabled="{Binding !IsRunning}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 4. Artwork -->
                    <StackPanel IsVisible="{Binding IsArtworkStep}">
                        <TextBlock Classes="section" Text="Artwork" />

                        <!-- Shared inputs for building any slot from a screenshot -->
                        <Border Classes="card" Margin="0,0,0,18" DataContext="{Binding ArtworkBuilder}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="13" FontWeight="Bold" Text="Build from a screenshot" />
                                    <TextBlock Classes="hint" FontSize="12" Text="Set these once, then build any slot below on its own with its Build button." />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Classes="label" Text="Screenshot" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding ScreenshotPath}" PlaceholderText="Pick an image of the game" FontSize="12" />
                                            <Button Grid.Column="1" Classes="sm" Content="Browse…" Command="{Binding PickScreenshotCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="label" Text="Name, line 1" />
                                        <TextBox Text="{Binding NameLine1}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="label" Text="Name, line 2" />
                                        <TextBox Text="{Binding NameLine2}" PlaceholderText="Optional" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="label" Text="Released" />
                                            <TextBox Classes="mono" Text="{Binding ReleaseYear}" MaxLength="4" Width="90" PlaceholderText="Year" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="label" Text="Players" />
                                            <ComboBox ItemsSource="{Binding PlayerChoices}" SelectedItem="{Binding Players}" Width="90" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="label" Text="Boot logo text" />
                                        <TextBox Text="{Binding LogoText}" PlaceholderText="Optional" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <WrapPanel ItemSpacing="22" LineSpacing="22">
                            <!-- Icon -->
                            <StackPanel Spacing="7">
                                <TextBlock Classes="label" Text="{Binding Icon.Label}" />
                                <Button Classes="slot" Command="{Binding Icon.PickCommand}" IsEnabled="{Binding !IsRunning}">
                                    <Panel Width="128" Height="128">
                                        <Rectangle Classes="slot-frame" RadiusX="16" RadiusY="16" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding Icon.Path, Converter={x:Static conv:FileImageConverter.IsMissing}}">
                                            <TextBlock Classes="fine" Text="Menu icon" TextAlignment="Center" />
                                            <TextBlock Classes="fine" Text="No preview" TextAlignment="Center" IsVisible="{Binding Icon.HasPath}" />
                                        </StackPanel>
                                        <Border CornerRadius="16" ClipToBounds="True" Margin="2">
                                            <Image Source="{Binding Icon.Path, Converter={x:Static conv:FileImageConverter.Bitmap}}" Stretch="UniformToFill" />
                                        </Border>
                                    </Panel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="fine" Text="{Binding Icon.Hint}" VerticalAlignment="Center" />
                                    <Button Classes="ghost sm tiny" Content="Clear" Command="{Binding Icon.ClearCommand}" IsVisible="{Binding Icon.HasPath}" IsEnabled="{Binding !IsRunning}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ArtworkBuilder.IconFrames}" SelectedItem="{Binding ArtworkBuilder.IconFrame}" HorizontalAlignment="Stretch" FontSize="12" IsEnabled="{Binding !IsRunning}" />
                                    <Button Grid.Column="1" Classes="sm" Content="Build" Command="{Binding ArtworkBuilder.BuildCommand}" CommandParameter="{x:Static wiiu:ImageSlot.Icon}" IsEnabled="{Binding !IsRunning}" ToolTip.Tip="Draw this one from the screenshot and the frame chosen here" />
                                </Grid>
                            </StackPanel>
                            <!-- TV boot screen -->
                            <StackPanel Spacing="7">
                                <TextBlock Classes="label" Text="{Binding BootTv.Label}" />
                                <Button Classes="slot" Command="{Binding BootTv.PickCommand}" IsEnabled="{Binding !IsRunning}">
                                    <Panel Width="256" Height="144">
                                        <Rectangle Classes="slot-frame" RadiusX="10" RadiusY="10" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding BootTv.Path, Converter={x:Static conv:FileImageConverter.IsMissing}}">
                                            <TextBlock Classes="fine" Text="TV boot screen" TextAlignment="Center" />
                                            <TextBlock Classes="fine" Text="No preview" TextAlignment="Center" IsVisible="{Binding BootTv.HasPath}" />
                                        </StackPanel>
                                        <Border CornerRadius="10" ClipToBounds="True" Margin="2">
                                            <Image Source="{Binding BootTv.Path, Converter={x:Static conv:FileImageConverter.Bitmap}}" Stretch="UniformToFill" />
                                        </Border>
                                    </Panel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="fine" Text="{Binding BootTv.Hint}" VerticalAlignment="Center" />
                                    <Button Classes="ghost sm tiny" Content="Clear" Command="{Binding BootTv.ClearCommand}" IsVisible="{Binding BootTv.HasPath}" IsEnabled="{Binding !IsRunning}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ArtworkBuilder.TvFrames}" SelectedItem="{Binding ArtworkBuilder.TvFrame}" HorizontalAlignment="Stretch" FontSize="12" IsEnabled="{Binding !IsRunning}" />
                                    <Button Grid.Column="1" Classes="sm" Content="Build" Command="{Binding ArtworkBuilder.BuildCommand}" CommandParameter="{x:Static wiiu:ImageSlot.BootTv}" IsEnabled="{Binding !IsRunning}" ToolTip.Tip="Draw this one from the screenshot and the frame chosen here" />
                                </Grid>
                            </StackPanel>
                            <!-- GamePad boot screen -->
                            <StackPanel Spacing="7">
                                <TextBlock Classes="label" Text="{Binding BootDrc.Label}" />
                                <Button Classes="slot" Command="{Binding BootDrc.PickCommand}" IsEnabled="{Binding !IsRunning}">
                                    <Panel Width="227" Height="128">
                                        <Rectangle Classes="slot-frame" RadiusX="10" RadiusY="10" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding BootDrc.Path, Converter={x:Static conv:FileImageConverter.IsMissing}}">
                                            <TextBlock Classes="fine" Text="GamePad boot screen" TextAlignment="Center" />
                                            <TextBlock Classes="fine" Text="No preview" TextAlignment="Center" IsVisible="{Binding BootDrc.HasPath}" />
                                        </StackPanel>
                                        <Border CornerRadius="10" ClipToBounds="True" Margin="2">
                                            <Image Source="{Binding BootDrc.Path, Converter={x:Static conv:FileImageConverter.Bitmap}}" Stretch="UniformToFill" />
                                        </Border>
                                    </Panel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="fine" Text="{Binding BootDrc.Hint}" VerticalAlignment="Center" />
                                    <Button Classes="ghost sm tiny" Content="Clear" Command="{Binding BootDrc.ClearCommand}" IsVisible="{Binding BootDrc.HasPath}" IsEnabled="{Binding !IsRunning}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ArtworkBuilder.GamePadFrames}" SelectedItem="{Binding ArtworkBuilder.GamePadFrame}" HorizontalAlignment="Stretch" FontSize="12" IsEnabled="{Binding !IsRunning}" />
                                    <Button Grid.Column="1" Classes="sm" Content="Build" Command="{Binding ArtworkBuilder.BuildCommand}" CommandParameter="{x:Static wiiu:ImageSlot.BootDrc}" IsEnabled="{Binding !IsRunning}" ToolTip.Tip="Draw this one from the screenshot and the frame chosen here" />
                                </Grid>
                            </StackPanel>
                            <!-- Boot logo -->
                            <StackPanel Spacing="7">
                                <TextBlock Classes="label" Text="{Binding BootLogo.Label}" />
                                <Button Classes="slot" Command="{Binding BootLogo.PickCommand}" IsEnabled="{Binding !IsRunning}">
                                    <Panel Width="227" Height="56">
                                        <Rectangle Classes="slot-frame" RadiusX="8" RadiusY="8" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding BootLogo.Path, Converter={x:Static conv:FileImageConverter.IsMissing}}">
                                            <TextBlock Classes="fine" Text="Boot logo" TextAlignment="Center" />
                                            <TextBlock Classes="fine" Text="No preview" TextAlignment="Center" IsVisible="{Binding BootLogo.HasPath}" />
                                        </StackPanel>
                                        <Border CornerRadius="8" ClipToBounds="True" Margin="2">
                                            <Image Source="{Binding BootLogo.Path, Converter={x:Static conv:FileImageConverter.Bitmap}}" Stretch="Uniform" />
                                        </Border>
                                    </Panel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="fine" Text="{Binding BootLogo.Hint}" VerticalAlignment="Center" />
                                    <Button Classes="ghost sm tiny" Content="Clear" Command="{Binding BootLogo.ClearCommand}" IsVisible="{Binding BootLogo.HasPath}" IsEnabled="{Binding !IsRunning}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ArtworkBuilder.LogoFrames}" SelectedItem="{Binding ArtworkBuilder.LogoFrame}" HorizontalAlignment="Stretch" FontSize="12" IsEnabled="{Binding !IsRunning}" />
                                    <Button Grid.Column="1" Classes="sm" Content="Build" Command="{Binding ArtworkBuilder.BuildCommand}" CommandParameter="{x:Static wiiu:ImageSlot.BootLogo}" IsEnabled="{Binding !IsRunning}" ToolTip.Tip="Draw this one from the screenshot and the frame chosen here" />
                                </Grid>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Boot sound -->
                        <Border Classes="divider" Margin="0,18,0,0" Padding="0,16,0,0" Width="560" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="label" Text="{Binding BootSound.Label}" />
                                    <TextBox Text="{Binding BootSound.Path}" IsReadOnly="True" PlaceholderText="Optional" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="sm icon" Command="{Binding PreviewSoundCommand}" VerticalAlignment="Bottom" ToolTip.Tip="Play it as the console will">
                                    <Panel>
                                        <Viewbox Width="14" Height="14" IsVisible="{Binding !IsPlayingSound}">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="btn-glyph" Fill="{DynamicResource ButtonTextBrush}" Data="M7 4.5v15l12-7.5Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox Width="14" Height="14" IsVisible="{Binding IsPlayingSound}">
                                            <Canvas Width="24" Height="24">
                                                <Path Classes="btn-glyph" Fill="{DynamicResource ButtonTextBrush}" Data="M6 6h12v12H6Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Panel>
                                </Button>
                                <Button Grid.Column="2" Classes="sm" Content="Pick" Command="{Binding BootSound.PickCommand}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Bottom" />
                                <Button Grid.Column="3" Classes="ghost sm" Content="Clear" Command="{Binding BootSound.ClearCommand}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                        <TextBlock Classes="fine" Text="{Binding BootSound.Hint}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- 5. Options -->
                    <StackPanel IsVisible="{Binding IsOptionsStep}">
                        <TextBlock Classes="section" Text="{Binding SelectedConsoleName, StringFormat='Options · {0}'}" />
                        <ContentControl Content="{Binding CurrentOptions}" IsEnabled="{Binding !IsRunning}" />
                    </StackPanel>

                    <!-- 6. Review & Inject -->
                    <StackPanel IsVisible="{Binding IsReviewStep}">
                        <TextBlock Classes="section" Text="Review &amp; Inject" />
                        <StackPanel Spacing="10" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="summary-label" Text="Console" />
                                <TextBlock Classes="summary-value" Text="{Binding SelectedConsoleName}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="summary-label" Text="Base" />
                                <TextBlock Classes="summary-value" Text="{Binding ReviewBase}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="summary-label" Text="ROM" />
                                <TextBlock Classes="summary-value" Text="{Binding ReviewRom}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="summary-label" Text="Game" />
                                <TextBlock Classes="summary-value" Text="{Binding ReviewGame}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="banner-warning" Margin="0,0,0,14" IsVisible="{Binding HasMissingKeys}">
                            <TextBlock Text="{Binding MissingKeysHint}" />
                        </Border>

                        <Border Classes="divider" Padding="0,16,0,0" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Button Classes="primary lg" Content="Inject" Command="{Binding InjectCommand}" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentStep}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Margin="0,14,0,0" Height="6" MinHeight="6" CornerRadius="4"
                                     Foreground="{DynamicResource CyanBrush}" Background="{DynamicResource DividerBrush}" />

                        <Border Classes="log" Margin="0,14,0,0" IsVisible="{Binding !!Log.Count}">
                            <ScrollViewer behaviors:AutoScroll.ToEnd="True">
                                <ItemsControl ItemsSource="{Binding Log}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Panel>
            </Border>
        </StackPanel>

        <!-- Wizard arrows: the mockup's glossy chevron, drawn as paths -->
        <Button Classes="arrow" Command="{Binding PreviousStepCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="Previous step">
            <Viewbox Width="76" Height="130" RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Viewbox.RenderTransform>
                <Canvas Width="200" Height="300">
                    <Path Classes="arrow-top" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 120, 50 150 L 180 150 Z" />
                    <Path Classes="arrow-bottom" Data="M 50 150 C 55 180, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                    <Path Classes="arrow-edge" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                </Canvas>
            </Viewbox>
        </Button>
        <Button Classes="arrow" Command="{Binding NextStepCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Next step">
            <Viewbox Width="76" Height="130">
                <Canvas Width="200" Height="300">
                    <Path Classes="arrow-top" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 120, 50 150 L 180 150 Z" />
                    <Path Classes="arrow-bottom" Data="M 50 150 C 55 180, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                    <Path Classes="arrow-edge" Data="M 50 20 C 40 10, 30 25, 45 60 C 55 90, 55 210, 45 240 C 30 275, 40 290, 50 280 L 180 150 Z" />
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
