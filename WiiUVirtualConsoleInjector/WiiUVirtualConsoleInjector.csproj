<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WiiUVirtualConsoleInjector</AssemblyName>
    <RootNamespace>WiiUVirtualConsoleInjector</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InternalsVisibleTo>WiiUVirtualConsoleInjector.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PD.WiiU.VirtualConsole\PD.WiiU.VirtualConsole.csproj" />
    <ProjectReference Include="..\PD.WiiU.VirtualConsole.Gba\PD.WiiU.VirtualConsole.Gba.csproj" />
    <ProjectReference Include="..\PD.WiiU.VirtualConsole.Infrastructure\PD.WiiU.VirtualConsole.Infrastructure.csproj" />
    <ProjectReference Include="..\PD.WiiU.VirtualConsole.Retro\PD.WiiU.VirtualConsole.Retro.csproj" />
    <ProjectReference Include="..\PD.WiiU.VirtualConsole.Wii\PD.WiiU.VirtualConsole.Wii.csproj" />
  </ItemGroup>

</Project>
