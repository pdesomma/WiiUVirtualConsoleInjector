<Project>

  <PropertyGroup>
    <!-- Sibling repos referenced as projects while they evolve together; override to point elsewhere. -->
    <WiiUSharpRoot Condition="'$(WiiUSharpRoot)' == ''">$(MSBuildThisFileDirectory)..\WiiUSharp\</WiiUSharpRoot>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('PD.'))">
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('PD.')) And '$(TargetFramework)' == 'net48'">
    <Compile Include="$(MSBuildThisFileDirectory).build\IsExternalInit.cs" Link="Internal\IsExternalInit.cs" />
  </ItemGroup>

</Project>
