<Window x:Class="UWUVCI_AIO_WPF.UI.Windows.IntroductionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UWUVCI Information and Quiz" Height="650" Width="760"
        MinHeight="460" MinWidth="560" WindowStartupLocation="CenterScreen"
        Background="White" Foreground="#202124" FontFamily="Segoe UI" FontSize="16">
    <Grid x:Name="TutorialRoot" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StepLabel" DockPanel.Dock="Right" Foreground="#5F6368"
                           FontSize="14" Margin="16,0,0,0"/>
                <TextBlock Text="UWUVCI AIO V3.N2" FontSize="14" Foreground="#5F6368"/>
            </DockPanel>
            <TextBlock x:Name="PageHeading" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,12,0,14"/>
            <ProgressBar x:Name="PageProgress" Height="4" Minimum="0"
                         Foreground="#2196F3" Background="#E8EAED"/>
        </StackPanel>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel x:Name="InformationPanel">
                    <ItemsControl x:Name="Paragraphs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="25"
                                           Margin="0,0,16,18"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="ReferenceLinks" Margin="0,4,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,20,12">
                                    <Hyperlink Tag="{Binding Target}" Click="ReferenceLink_Click">
                                        <Run Text="{Binding Label, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="QuizPanel" Visibility="Collapsed">
                    <TextBlock Text="Answer every question. All answers must be correct to pass."
                               TextWrapping="Wrap" Margin="0,0,16,24"/>
                    <ItemsControl x:Name="QuizQuestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,28">
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Answers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="{Binding GroupName}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             HorizontalContentAlignment="Stretch"
                                                             MinHeight="36" Padding="6" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                               LineHeight="23"/>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="Feedback" Foreground="#B3261E" TextWrapping="Wrap"
                       Margin="0,0,0,10" Visibility="Collapsed"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="Back" Width="96" Height="38"
                        Click="BackButton_Click"/>
                <Button Grid.Column="2" Content="Close" Width="96" Height="38"
                        Margin="0,0,12,0" IsCancel="True"/>
                <Button x:Name="NextButton" Grid.Column="3" Content="Next" Width="140"
                        Height="38" Click="NextButton_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
